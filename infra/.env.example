# ═══════════════════════════════════════════════════════
#  infra/.env  –  Production environment for Contabo VPS
#  Copy this to infra/.env and fill in real values.
#  NEVER commit infra/.env to git!
# ═══════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────
TZ=Asia/Phnom_Penh

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_DB=property_valuation
POSTGRES_USER=pv_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── JWT ───────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_RANDOM_64_CHARS
JWT_REFRESH_EXPIRES_IN=14d

# ── Application URLs (match your domain) ─────────────
APP_URL=https://api.camtopproperty.site
FRONTEND_URL=https://camtopproperty.site
CORS_ORIGINS=https://camtopproperty.site,https://www.camtopproperty.site

# ── Frontend public env (injected at build time) ─────
NEXT_PUBLIC_API_URL=https://api.camtopproperty.site/api
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=YOUR_GOOGLE_MAPS_BROWSER_KEY
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAPS_MAP_ID

# ── Email (Resend recommended for production) ─────────
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@camtopproperty.site
EMAIL_LOGO_URL=https://camtopproperty.site/logo/camtop_logo.svg
EMAIL_VERIFY_LINK_TARGET=backend
RESEND_API_KEY=re_CHANGE_ME

# ── Cloudflare R2 Storage ─────────────────────────────
CLOUDFLARE_ACCOUNT_ID=CHANGE_ME
CLOUDFLARE_ACCESS_KEY_ID=CHANGE_ME
CLOUDFLARE_SECRET_ACCESS_KEY=CHANGE_ME
CLOUDFLARE_BUCKET_NAME=property-valuation
CLOUDFLARE_BUCKET_REGION=auto
CLOUDFLARE_R2_PUBLIC_URL=https://pub-CHANGE_ME.r2.dev

# ── Google Maps (Server-side) ─────────────────────────
GOOGLE_MAP_API_KEY=CHANGE_ME
GOOGLE_GEOCODING_API_KEY=CHANGE_ME

# ── Backup ────────────────────────────────────────────
BACKUP_RETENTION_DAYS=14

# ── Misc ──────────────────────────────────────────────
TRUST_PROXY=1
NODE_ENV=production
PORT=4000
