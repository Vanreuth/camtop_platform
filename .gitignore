# ─────────────────────────────────────────────────────────────────────────
#  Root .gitignore  –  Monorepo (backend + frontend + infra)
# ─────────────────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────
node_modules/
**/node_modules/

# ── Environment files (NEVER commit real .env) ────────
.env
.env.local
.env.*.local
infra/.env
!infra/.env.example
property_valution_api/.env
property_valution_api/.env.*
!property_valution_api/.env.example
property_valution_system/.env
property_valution_system/.env.*
!property_valution_system/.env.example

# ── Build outputs ─────────────────────────────────────
dist/
build/
out/
coverage/
property_valution_api/dist/
property_valution_system/.next/
property_valution_system/out/

# ── Docker / Infra volumes (host paths) ───────────────
infra/postgres_data/
infra/npm/
infra/backups/

# ── Logs ─────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS / IDE ─────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── TypeScript ────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Misc ──────────────────────────────────────────────
.turbo/
*.pem
*.key
*.crt
