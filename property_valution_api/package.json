  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:seed": "npx tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "deploy:seed": "node -e \"if(process.env.RUN_SEED==='true'){require('child_process').execSync('npm run prisma:seed',{stdio:'inherit'})}else{console.log('Skipping seed RUN_SEED=false')}\"",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build -d",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up --build -d",
    "docker:down:dev": "docker-compose -f docker-compose.dev.yml down",
    "docker:down:prod": "docker-compose -f docker-compose.prod.yml down",
    "cleanToken": "tsx src/script/cleanToken.ts",
    "test:google-maps": "tsx src/script/testGoogleMap.ts",
    "generate:secrets": "tsx src/script/generateSecrets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.896.0",
